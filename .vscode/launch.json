{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python: Client Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/source/packages/automojo/gitlab/rest/generation/restclientgenerator.py",
            "args": [
                "--client-classname=GitLabRestClient",
                "--client-root=${workspaceFolder}/source/packages/automojo/gitlab/rest/clients",
                "--specfile=${workspaceFolder}/source/packages/automojo/gitlab/rest/descriptions/gitlab-openapi-spec.yaml"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
